    "neutral": {
      "$note": "审查 2026-10-04 §8.3.1:中性色阶 13 档(N0~N12),替代「只有 3 档文字色」。深色从深到浅(机身→文字);浅色反向独立调校(不是深色反相),从亮到暗。文字级达标口径:N12/N10/disabled-fg 对承载底 ≥4.5:1(WCAG AA);N9 为装饰级弱文字,禁用文字一律走 state-layer.disabled-fg。",
      "dark": {
        "n0":  { "value": "#0E0E10", "desc": "窗口/机身最底" },
        "n1":  { "value": "#161618", "desc": "画布外区域(画板外更暗)" },
        "n2":  { "value": "#1C1C1E", "desc": "画布" },
        "n3":  { "value": "#232326", "desc": "面板底(坞/状态栏)" },
        "n4":  { "value": "#2A2A2E", "desc": "面板" },
        "n5":  { "value": "#313136", "desc": "凸起/输入" },
        "n6":  { "value": "#3A3A40", "desc": "悬停基准" },
        "n7":  { "value": "#45454C", "desc": "按下基准" },
        "n8":  { "value": "#55555E", "desc": "分隔强" },
        "n9":  { "value": "#6E6E78", "desc": "弱文字(装饰级;对 n4 仅 2.76:1,禁用文字走 state-layer.disabled-fg)" },
        "n10": { "value": "#9A9AA4", "desc": "次文字(对 n4 ≈5.0:1,达 AA)" },
        "n11": { "value": "#C7C7CE", "desc": "强调次文字/代码" },
        "n12": { "value": "#FFFFFF", "desc": "主文字(对 n4 ≈15:1)" }
      },
      "light": {
        "n0":  { "value": "#FFFFFF", "desc": "画布/画板/面板(最高反射面)" },
        "n1":  { "value": "#F7F7F8", "desc": "机身/窗口底" },
        "n2":  { "value": "#F1F1F3", "desc": "画布外区域" },
        "n3":  { "value": "#EDEDF0", "desc": "面板内嵌面(卡片/分组)" },
        "n4":  { "value": "#E8E8EB", "desc": "输入/凸起底" },
        "n5":  { "value": "#DDDDE1", "desc": "悬停基准" },
        "n6":  { "value": "#CFCFD5", "desc": "按下基准" },
        "n7":  { "value": "#B4B4BC", "desc": "分隔强/图标弱" },
        "n8":  { "value": "#98989F", "desc": "分隔/描边" },
        "n9":  { "value": "#8A8A92", "desc": "弱文字(装饰级;对 n0 仅 3.43:1,禁用文字走 state-layer.disabled-fg)" },
        "n10": { "value": "#6B6B6B", "desc": "次文字(对 n0 ≈5.3:1,达 AA;= color.light.text-2)" },
        "n11": { "value": "#3E3E44", "desc": "图标/强次文字" },
        "n12": { "value": "#1B1B1F", "desc": "主文字(对 n0 ≈17:1)" }
      }
