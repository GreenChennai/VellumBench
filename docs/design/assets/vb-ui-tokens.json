  },

  "radius": {
    "$note": "egui 默认 2px 是'业余感'三大来源之一。全局提至 6px。",
    "sm": { "value": "4px", "egui": "CornerRadius::same(4)" },
    "md": { "value": "6px", "egui": "CornerRadius::same(6)", "use": "按钮/Tab/下拉/输入框" },
    "lg": { "value": "8px", "egui": "CornerRadius::same(8)", "use": "面板内卡片/分组块/menu" },
    "xl": { "value": "12px", "egui": "CornerRadius::same(12)", "use": "底部工具条/浮层/window" }
  },

  "stroke": {
    "hairline": { "value": "1px" },
    "focus":    { "value": "1.5px" },
    "canvas-select": { "value": "1px", "color": "{color.semantic.select-box}" }
  },

  "elevation": {
    "$note": "审查 2026-10-04 §8.3.2 材质阶梯(UI-04 的令牌面)。深色靠 elevation 阶梯 + 顶部高光发丝线分层,不靠描边堆叠。base 引用 color.neutral.*(单一真相);阴影 offset 单位 px,color 为 rgba(解析后 α×255 四舍五入)。egui 仅 window_shadow/popup_shadow 两槽(§8.3.2 L3「对话框/菜单/命令面板」),tooltip 专属 L4 由 S4 组件消费。",
    "dark": {
      "L0": { "base": "{color.neutral.dark.n1}", "hairline": "none", "shadow": "none", "use": "画布外区域" },
      "L1": { "base": "{color.neutral.dark.n3}", "hairline": "rgba(255,255,255,0.05)", "shadow": "none", "use": "工具箱/坞/状态栏(靠层次不靠阴影)" },
      "L2": { "base": "{color.neutral.dark.n5}", "hairline": "rgba(255,255,255,0.05)", "shadow": { "offset": [0, 1], "blur": 2,  "spread": 0, "color": "rgba(0,0,0,0.35)" }, "use": "输入框/Tab 选中/下拉" },
      "L3": { "base": "{color.neutral.dark.n6}", "hairline": "rgba(255,255,255,0.05)", "shadow": { "offset": [0, 8], "blur": 24, "spread": 0, "color": "rgba(0,0,0,0.45)" }, "use": "对话框/菜单/命令面板", "egui": "visuals.window_shadow + visuals.popup_shadow" },
      "L4": { "base": "{color.neutral.dark.n7}", "hairline": "rgba(255,255,255,0.05)", "surface_alpha": 0.92, "shadow": { "offset": [0, 4], "blur": 16, "spread": 0, "color": "rgba(0,0,0,0.50)" }, "use": "tooltip/浮动工具条/数值浮层(S4 组件消费)" }
    },
    "light": {
      "$note": "浅色阴影独立调校(更轻):面板白底靠 window_shadow + 描边分层,阴影值压低避免脏灰。",
      "L0": { "base": "{color.neutral.light.n2}", "hairline": "none", "shadow": "none", "use": "画布外区域" },
      "L1": { "base": "{color.neutral.light.n0}", "hairline": "rgba(0,0,0,0.04)", "shadow": "none", "use": "工具箱/坞/状态栏" },
      "L2": { "base": "{color.neutral.light.n4}", "hairline": "rgba(0,0,0,0.04)", "shadow": { "offset": [0, 1], "blur": 2,  "spread": 0, "color": "rgba(0,0,0,0.10)" }, "use": "输入框/Tab 选中/下拉" },
      "L3": { "base": "{color.neutral.light.n0}", "hairline": "rgba(0,0,0,0.04)", "shadow": { "offset": [0, 8], "blur": 24, "spread": 0, "color": "rgba(0,0,0,0.14)" }, "use": "对话框/菜单/命令面板", "egui": "visuals.window_shadow + visuals.popup_shadow" },
      "L4": { "base": "{color.neutral.light.n1}", "hairline": "rgba(0,0,0,0.04)", "surface_alpha": 0.96, "shadow": { "offset": [0, 4], "blur": 16, "spread": 0, "color": "rgba(0,0,0,0.16)" }, "use": "tooltip/浮动工具条/数值浮层(S4 组件消费)" }
    }
  },

  "state-layer": {
    "$note": "审查 2026-10-04 §8.3.3:状态一律 **alpha 叠加于基础色**,不再换灰阶常量。overlay 为半透明状态色,经 theme::state::over(base, overlay) 合成;组件过渡动画用 theme::state::fade 缩放 α。focus-ring = accent 全强 1.5px 外描边,inner 为隔离环。disabled 只降前景不降容器饱和度;disabled-fg 沿用 U-6 走查的 AA 达标值(N9 对面板仅 2.76:1 不达标,故不取 N9)。",
    "dark": {
      "hover":            { "value": "rgba(255,255,255,0.06)", "desc": "悬停:白 6% 叠加" },
      "press":            { "value": "rgba(255,255,255,0.10)", "desc": "按下:白 10% 叠加" },
      "selected":         { "value": "rgba(13,153,255,0.14)",  "desc": "选中:accent 14%(#0D99FF24)" },
      "focus-ring":       { "value": "rgba(13,153,255,1.00)",  "desc": "焦点环外描边(accent 全强,1.5px);对 n4 ≈5.1:1 达 1.4.11(≥3:1)" },
      "focus-ring-inner": { "value": "rgba(0,0,0,0.40)",       "desc": "焦点环内侧隔离环" },
      "disabled-fg":      { "value": "#96969B",                "desc": "禁用前景(= text-3;对 n4/n5 ≥4.5:1)" }
    },
    "light": {
      "hover":            { "value": "rgba(0,0,0,0.04)",       "desc": "悬停:黑 4% 叠加" },
      "press":            { "value": "rgba(0,0,0,0.08)",       "desc": "按下:黑 8% 叠加" },
      "selected":         { "value": "rgba(13,153,255,0.14)",  "desc": "选中:accent 14%" },
      "focus-ring":       { "value": "rgba(0,114,214,1.00)",  "desc": "焦点环外描边(S5 收口:accent 深阶 #0072D6,白 4.80/画布 4.40/n4 3.92,达 1.4.11)" },
      "focus-ring-inner": { "value": "rgba(255,255,255,0.90)", "desc": "焦点环内侧隔离环(浅色用白隔离)" },
      "disabled-fg":      { "value": "#767676",                "desc": "禁用前景(= text-3;对白底 4.54:1)" }
    }
  },

  "typography": {
    "$note": "审查 2026-10-04 §8.4 排版七档(G-UI-A 第四表)。行高是布局真相(egui FontId 无行高,组件经 row-height 公式消费);字重经独立 FontFamily(vb-ui-regular/medium/semibold)实现。本表与上方 font.size 六档的 size 必须一致(有测试钉住;font.size 因 vb_kit 镜像冻结而保留)。",
    "display":     { "size": "24px", "line-height": "32px", "weight": 600, "use": "启动器标题/空态主标题", "egui": "vb-display 具名 style" },
    "title":       { "size": "15px", "line-height": "22px", "weight": 600, "use": "对话框标题/面板组标题", "egui": "TextStyle::Heading" },
    "body-strong": { "size": "13px", "line-height": "20px", "weight": 600, "use": "分组头/选中项", "egui": "vb-body-strong 具名 style + TextStyle::Button" },
    "body":        { "size": "13px", "line-height": "20px", "weight": 400, "use": "默认正文", "egui": "TextStyle::Body" },
    "label":       { "size": "12px", "line-height": "18px", "weight": 500, "use": "字段标签/图层行", "egui": "vb-label 具名 style" },
    "caption":     { "size": "11px", "line-height": "16px", "weight": 400, "use": "状态栏/tooltip 副行", "egui": "TextStyle::Small" },
    "mono":        { "size": "12px", "line-height": "18px", "weight": 400, "use": "十六进制/数值框/代码;数字一律走 vb-mono 等宽族实现 tabular-nums", "egui": "TextStyle::Monospace" }
  },

  "font": {
    "family": {
      "latin":  { "value": "Inter", "license": "SIL OFL 1.1", "weights": ["Regular", "Medium", "SemiBold"] },
