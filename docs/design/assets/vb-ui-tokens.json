      "caption":       { "size": "11px", "line_height": "16px", "weight": 400, "style": "Small",     "use": "状态栏/tooltip 副行" },
      "label":         { "size": "12px", "line_height": "18px", "weight": 500, "style": "Small",     "use": "字段标签/图层行" },
      "body":          { "size": "13px", "line_height": "20px", "weight": 400, "style": "Body",      "use": "默认正文/输入内容" },
      "body-strong":   { "size": "13px", "line_height": "20px", "weight": 600, "style": "Button",    "use": "面板分组标题/选中项" },
      "title":         { "size": "15px", "line_height": "22px", "weight": 600, "style": "Heading",   "use": "对话框标题" },
      "mono":          { "size": "12px", "line_height": "18px", "weight": 400, "style": "Monospace", "use": "十六进制/代码视图" }
    }
