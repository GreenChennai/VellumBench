    "ext": {
      "$note": "审查 2026-10-04 §8.3.4 功能色扩展。独立于上面两套冻结键集(vb_kit 镜像),由 vb_ui tokens_sync 功能色测试逐值校验。语义色(智能参考线品红等)保持不可变,不在此表。",
      "dark": {
        "accent-press":  { "value": "#0B87E5", "desc": "accent 按下(比 hover 深)" },
        "accent-subtle": { "value": "rgba(13,153,255,0.14)", "desc": "选中底/Tab 选中底(#0D99FF24);S4 起接替 accent-dim" },
        "accent-border": { "value": "rgba(13,153,255,0.50)", "desc": "accent 描边(#0D99FF80)" },
        "info":          { "value": "#5E5CE6", "desc": "非破坏提示(与 accent 区分);对 n4 仅 ≈2.7:1,只作图标/容器底,不作小号正文" }
      },
      "light": {
        "accent-press":  { "value": "#0B87E5", "desc": "accent 按下" },
        "accent-subtle": { "value": "rgba(13,153,255,0.14)", "desc": "选中底(两套共用,设计规范 §8.3.3)" },
        "accent-border": { "value": "rgba(13,153,255,0.50)", "desc": "accent 描边" },
        "info":          { "value": "#4B49CC", "desc": "非破坏提示(浅色加深保对比)" }
      }
    }
