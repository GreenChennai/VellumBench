  "motion": {
    "$note": "绝不做的动效：画布元素入场动画、按钮弹跳、粒子效果。工具软件里这些是减速带。",
    "instant": { "value": "0ms",   "use": "画布缩放/平移/拖动", "impl": "直接赋值，不走动画" },
    "hover":   { "value": "80ms",  "use": "悬停变色",           "impl": "Style.animation_time = 0.08" },
    "state":   { "value": "120ms", "use": "选中/开关/展开收起",   "impl": "ctx.animate_bool_with_time(id, v, 0.12)" },
    "popup":   { "value": "150ms", "use": "下拉/tooltip 淡入",   "impl": "egui 内建" },
    "panel":   { "value": "200ms", "use": "面板折叠/Tab 切换",    "impl": "ctx.animate_value_with_time(id, v, 0.20)" }
  },

  "layout": {
